# nested loop = A loop within another loop (outer, inner)

# =======================================================
# Inner loop
# runs completely for each iteration of the outer loop
# =======================================================

for x in range(1, 10):
    print(x, end="")

# =======================================================
# Outer loop
# runs completely for each iteration of the inner loop
# =======================================================

for x in range(3):
    for y in range(1, 10):
        print(y, end="")
    print()  # New line after each iteration of the outer loop

# =======================================================
# Project
# Print a rectangle made of symbols using nested loops
# =======================================================

rows = int(input("Enter the number of rows: "))
columns = int(input("Enter the number of columns: "))
symbol = input("Enter a symbol to use: ")

for x in range(rows):
    for y in range(columns):
        print(symbol, end="")
    print()  # New line after each row